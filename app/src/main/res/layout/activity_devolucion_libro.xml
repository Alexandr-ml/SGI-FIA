<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devolucion de libro"
            android:textColor="#1A1A1A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro de devolución."
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Id de prestamo."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etIdPrestamo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/edit_text"
            android:hint="ISBN o identificador"
            android:paddingLeft="12dp"
            android:layout_marginBottom="24dp"
            android:inputType="text"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <CheckBox
                android:id="@+id/cbMarcarDevuelto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marcar libro como devuelto"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:buttonTint="#10B981"/> </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de devolución."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <EditText
            android:id="@+id/etFechaDevolucion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/edit_text"
            android:hint="25/07/2026"
            android:paddingLeft="12dp"
            android:layout_marginBottom="40dp"
            android:inputType="date"
            android:drawableRight="@android:drawable/ic_menu_my_calendar"
            android:paddingRight="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnRegistrarDevolucion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.1"
                android:layout_marginRight="8dp"
                android:backgroundTint="#2E2E2E"
                android:text="Registrar devolución"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCancelarDevolucion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.9"
                android:layout_marginLeft="8dp"
                android:backgroundTint="#E52424"
                android:text="Cancelar"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>