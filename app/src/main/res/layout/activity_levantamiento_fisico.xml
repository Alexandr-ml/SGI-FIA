<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="40dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Levantamiento fisico."
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:text="Fecha de levantamiento."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etFechaLevantamientoFisico"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar_16"
            android:focusable="false"
            android:hint="25/07/2026"
            android:inputType="date"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8F98"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Numero de serie."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etNumeroSerieLevantamiento"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="text"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnEscanearLevantamiento"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_dark_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_scan_14"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:text="Escanear"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Activos registrados"
            android:textColor="#333333"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/contenedorActivosLevantamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Historial de auditorias"
            android:textColor="#333333"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/contenedorHistorialAuditoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFinalizarLevantamiento"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Finalizar"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnCancelarLevantamiento"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_red_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
