<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Levantamiento Físico Anual"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auditoría de activos y control de faltantes (FIA):"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Año Periodo"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinner_periodo_auditoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación a Revisar"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinner_ubicacion_auditoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar Equipo (ID o Número de Serie)"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edit_buscar_auditoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite serie o toque para buscar..."
            android:textSize="13sp"
            android:background="@android:drawable/edit_text"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:importantForAutofill="no"
            android:layout_marginBottom="12dp"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/dialog_holo_light_frame"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txt_info_equipo_auditoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalles del Equipo:\nEsperando búsqueda de activo..."
                android:textColor="#333333"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"/>

            <RadioGroup
                android:id="@+id/radio_group_estado_auditoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:weightSum="2">

                <RadioButton
                    android:id="@+id/radio_encontrado"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Encontrado"
                    android:textSize="13sp"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/radio_no_encontrado"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="No Encontrado"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"/>
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observaciones / Notas"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edit_observaciones_auditoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej: Se encontró en otra oficina / Dañado"
            android:textSize="13sp"
            android:importantForAutofill="no"
            android:background="@android:drawable/edit_text"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_marginBottom="14dp"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/txt_resumen_auditoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen: Auditados: 0 | Restantes: 0 | Faltantes: 0"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_regresar_auditoria"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Regresar"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:layout_marginRight="4dp"
                tools:ignore="MarginLeftRight" />

            <Button
                android:id="@+id/btn_guardar_auditoria"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Guardar Registro"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                android:layout_marginLeft="4dp"
                tools:ignore="MarginLeftRight" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>