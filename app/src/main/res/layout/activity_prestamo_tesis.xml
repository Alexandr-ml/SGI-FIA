<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="26dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="Prestamo de tesis"
                    android:textColor="#1A1A1A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Por horas"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="ID automatico de prestamo"
                android:textColor="#1A1A1A"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Busque el prestatario del equipo."
            android:textColor="#333333"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnBuscarPrestatarioTesis"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_dark_compact"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Buscar prestatario"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Prestar a:"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombrePrestatarioTesis"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:hint="Nombre de prestatario"
            android:inputType="textPersonName"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8F98"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Tesis prestada"
            android:textColor="#333333"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/etTituloTesis"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:hint="Aplicaciones de arboles Van Emde Boas"
            android:inputType="textCapSentences"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8F98"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha del Prestamo"
            android:textColor="#333333"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/etFechaPrestamoTesis"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar_16"
            android:focusable="false"
            android:hint="06/06/2026"
            android:inputType="date"
            android:textColor="#1A1A1A"
            android:textColorHint="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha Limite"
            android:textColor="#333333"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/etFechaDevolucionTesis"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar_16"
            android:focusable="false"
            android:hint="06/06/2026"
            android:inputType="date"
            android:textColor="#1A1A1A"
            android:textColorHint="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado del Prestamo"
            android:textColor="#333333"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Activo"
                android:textColor="#1A1A1A"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnEstadoPendienteTesis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Pendiente"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRegistrarPrestamoTesis"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Registrar prestamo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnCancelarPrestamoTesis"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_red_compact"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
