<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="29dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Agregar equipo\ninformatico."
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Numero de serie."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etNumeroSerieEquipoInventario"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="text"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnEscanearEquipoInventario"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_button_dark_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_scan_14"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:text="Escanear"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Marca."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etMarcaEquipoInventario"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="textCapWords"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Modelo."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etModeloEquipoInventario"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="text"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Ubicacion."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etUbicacionEquipoInventario"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="textCapSentences"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Costo por unidad."
                    android:textColor="#333333"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/etCostoEquipoInventario"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_compact"
                    android:hint="$ 0.00"
                    android:inputType="numberDecimal"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#1A1A1A"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unidades."
                    android:textColor="#333333"
                    android:textSize="9sp" />

                <Spinner
                    android:id="@+id/spinnerUnidadesEquipoInventario"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_compact"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Descripcion."
            android:textColor="#333333"
            android:textSize="9sp" />

        <EditText
            android:id="@+id/etDescripcionEquipoInventario"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:gravity="top"
            android:hint="Value"
            android:inputType="textMultiLine"
            android:textColor="#1A1A1A"
            android:textColorHint="#1A1A1A"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAnadirEquipoInventario"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Anadir"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnCancelarEquipoInventario"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_red_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
