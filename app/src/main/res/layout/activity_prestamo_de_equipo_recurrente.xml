<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBotones"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Préstamo Recurrente de Equipo"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Responsable:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etResponsablePrestamo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. Ing. Carlos Martínez"
                android:inputType="textPersonName"
                android:paddingLeft="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contacto (Correo / Extensión):"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etContactoPrestamo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. ext 405 / carlos.m@ues.edu.sv"
                android:inputType="text"
                android:paddingLeft="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Materia y Horario del Ciclo (FIA):"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etMateriaHorario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. Lu-Mi 4:50 - 6:30 pm (BD115)"
                android:inputType="text"
                android:paddingLeft="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de Inicio del Préstamo:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etFechaInicio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="23/05/2026"
                android:inputType="date"
                android:paddingLeft="12dp"
                android:drawableRight="@android:drawable/ic_menu_my_calendar"
                android:paddingRight="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de Fin del Préstamo:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etFechaFin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="20/11/2026"
                android:inputType="date"
                android:paddingLeft="12dp"
                android:drawableRight="@android:drawable/ic_menu_my_calendar"
                android:paddingRight="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Número de Serie del Equipo a Prestar:"
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etSerieEquipo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ej. FIA-LP-203"
                android:inputType="textCapCharacters"
                android:paddingLeft="12dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="25dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnRegistrarPrestamo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.1"
            android:backgroundTint="#2E2E2E"
            android:text="Registrar préstamo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnCancelarPrestamo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="0.9"
            android:backgroundTint="#E52424"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</RelativeLayout>