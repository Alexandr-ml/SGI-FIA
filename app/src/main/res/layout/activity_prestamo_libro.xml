<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="25dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Prestamo"
            android:textColor="#1A1A1A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="de un Libro"
            android:textColor="#666666"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="ID automatico de prestamo"
            android:textColor="#333333"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etIdPrestamoLibro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_compact"
                android:enabled="false"
                android:inputType="none"
                android:textColor="#1A1A1A"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Libro"
                android:src="@drawable/ic_book_24" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="#E5E7EB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Prestar a:"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombrePrestatarioLibro"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input_compact"
            android:hint="Nombre de prestatario"
            android:inputType="textPersonName"
            android:textColor="#1A1A1A"
            android:textColorHint="#8A8F98"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBuscarPrestatarioLibro"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_dark_compact"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Buscar prestatario"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Libro Prestado"
            android:textColor="#333333"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etTituloLibro"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:inputType="textCapSentences"
            android:text="Libro Fundamentos de la Programacion"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Fecha del Prestamo"
            android:textColor="#333333"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etFechaPrestamoLibro"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar_16"
            android:focusable="false"
            android:inputType="date"
            android:text="06/06/2026"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha Limite"
            android:textColor="#333333"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etFechaLimiteLibro"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_compact"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar_16"
            android:focusable="false"
            android:inputType="date"
            android:text="06/06/2026"
            android:textColor="#1A1A1A"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado del Prestamo"
            android:textColor="#333333"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Activo"
                android:textColor="#1A1A1A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnEstadoPendienteLibro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:gravity="center"
                android:text="Pendiente"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRegistrarPrestamoLibro"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Registrar prestamo"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnCancelarPrestamoLibro"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_red_compact"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
