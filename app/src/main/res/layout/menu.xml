<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".controller.MenuActivity">

    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212121"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SGI - FIA"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú de Acciones"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerArea">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GESTIÓN DE HARDWARE E INFORMÁTICA"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNuevoEquipoInformatico"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Añadir nuevo equipo informático"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#212121"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnPrestamoPorHoras"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Préstamo de equipo por horas"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#424242"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnPrestamoRecurrente"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Préstamo recurrente de equipo"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#424242"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnLevantamientoFisico"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Levantamiento físico anual"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DCDCDC"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTROL DE BIBLIOTECA"
                android:textColor="#666666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNuevoLibro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Añadir nuevo libro"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#212121"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnNuevaTesis"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Añadir nueva tesis"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#212121"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_dev_libro"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Devolución de libro"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#212121"
                android:backgroundTint="#E0E0E0"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btn_dev_tesis"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Devolución de tesis"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#212121"
                android:backgroundTint="#E0E0E0"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>