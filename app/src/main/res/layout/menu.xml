<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".controller.MenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Acciones"
            android:textColor="#1A1A1A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNuevoEquipoInformatico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="Anadir nuevo equipo informatico" />

        <Button
            android:id="@+id/btnNuevoLibro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="Anadir nuevo libro" />

        <Button
            android:id="@+id/btnNuevaTesis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:text="Anadir nueva tesis" />

        <Button
            android:id="@+id/btnPrestamoPorHoras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="Prestamo de equipo por horas" />

        <Button
            android:id="@+id/btnPrestamoRecurrente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="Prestamo recurrente de equipo" />

        <Button
            android:id="@+id/btnPrestamoTesis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="Prestamo de tesis" />

        <Button
            android:id="@+id/btnLevantamientoFisico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Levantamiento fisico" />
    </LinearLayout>
</ScrollView>
